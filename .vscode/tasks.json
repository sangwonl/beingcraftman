{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "&&",
                "cmake",
                "--build",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "CMake build task"
        },
        {
            "label": "build-gazeshot",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/game/gazeshot/src/build",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build gazeshot game"
        }
    ]
}
